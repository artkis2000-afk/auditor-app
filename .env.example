# ==========================================
# ФУРЫ ЗАПЧАСТИ — переменные окружения
# Скопируйте в .env и заполните реальными значениями. .env НЕ коммитится.
# ==========================================

# --- Server ---
PORT=3000
NODE_ENV=development

# --- Auth (PHASE 4.5) ---
# Секрет для подписи JWT. В production обязателен собственный сильный секрет.
JWT_SECRET=change-me-in-production

# --- Gemini AI / OCR (PHASE 4.6) ---
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# --- Firebase / Firestore (PHASE 4.3) ---
# Существующий проект и база данных (источник истины). Значения — клиентская web-конфигурация Firebase.
FIREBASE_PROJECT_ID=zakupki-auditor
FIREBASE_API_KEY=
FIREBASE_APP_ID=
FIREBASE_AUTH_DOMAIN=zakupki-auditor.firebaseapp.com
FIREBASE_STORAGE_BUCKET=zakupki-auditor.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=
FIRESTORE_DATABASE_ID=ai-studio-527e9c56-1154-4b10-ae2e-2b1cd4743c8f
