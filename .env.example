# ==========================================
# ФУРЫ ЗАПЧАСТИ — переменные окружения
# Скопируйте в .env и заполните реальными значениями. .env НЕ коммитится.
# ==========================================

# --- Server ---
PORT=3000
NODE_ENV=development

# --- Auth (PHASE 4.5) ---
# Секрет для подписи JWT. В production обязателен собственный сильный секрет.
JWT_SECRET=change-me-in-production

# --- Gemini AI / OCR (PHASE 4.6) ---
# Ключ опционален: без него OCR работает на демо-fallback (реальный Gemini не вызывается).
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
# Id модели Gemini для OCR (конфигурируемо; стабильный дефолт — gemini-3.8-flash).
GEMINI_OCR_MODEL=gemini-3.8-flash

# --- Firebase / Firestore (Admin SDK, server-side) ---
FIREBASE_PROJECT_ID=zakupki-app-3207e
FIRESTORE_DATABASE_ID=(default)
# Бакет Firebase Storage для оригиналов накладных (без префикса gs://).
FIREBASE_STORAGE_BUCKET=zakupki-app-3207e.firebasestorage.app

# --- Аутентификация Admin SDK (KEYLESS; приватный ключ НЕ используется) ---
# Выбор провайдера (server/db/adminApp.ts): serviceAccount → WIF → ADC.
#
# LOCAL: ничего из нижеперечисленного задавать не нужно — используйте ADC с impersonation:
#   gcloud auth application-default login \
#     --impersonate-service-account=auditor-backend@zakupki-app-3207e.iam.gserviceaccount.com
#
# PRODUCTION (Vercel OIDC → GCP Workload Identity Federation): задайте GCP_* переменные.
#   VERCEL_OIDC_TOKEN инжектится Vercel автоматически (включите OIDC в настройках проекта).
# GCP_PROJECT_NUMBER=1234567890
# GCP_WORKLOAD_IDENTITY_POOL_ID=vercel
# GCP_WORKLOAD_IDENTITY_POOL_PROVIDER_ID=vercel
# GCP_SERVICE_ACCOUNT_EMAIL=auditor-backend@zakupki-app-3207e.iam.gserviceaccount.com
# GCP_AUDIENCE=  # опционально: https://iam.googleapis.com/projects/<num>/locations/global/workloadIdentityPools/vercel/providers/vercel
#
# ESCAPE HATCH (НЕ рекомендуется): весь service-account JSON строкой.
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"zakupki-app-3207e",...}

# --- CORS (нужно только когда фронт и бэк на РАЗНЫХ доменах, т.е. на Vercel) ---
# Список разрешённых origin фронтенда через запятую. Поддерживается '*' для preview-доменов.
# Пусто (локально/один origin) → CORS не включается. НЕ ставьте '*' как весь origin.
# WEB_ORIGIN=https://auditor-web.vercel.app,https://auditor-web-*.vercel.app

# ==========================================
# PRODUCTION (Vercel) — какие ENV задавать в Dashboard каждого проекта:
#   auditor-api (backend, Root=репозиторий):
#     NODE_ENV=production
#     JWT_SECRET, GEMINI_API_KEY, GEMINI_OCR_MODEL
#     FIREBASE_PROJECT_ID, FIRESTORE_DATABASE_ID, FIREBASE_STORAGE_BUCKET
#     GCP_PROJECT_NUMBER, GCP_WORKLOAD_IDENTITY_POOL_ID, GCP_WORKLOAD_IDENTITY_POOL_PROVIDER_ID,
#     GCP_SERVICE_ACCOUNT_EMAIL (WIF; VERCEL_OIDC_TOKEN инжектится автоматически при включённом OIDC)
#     WEB_ORIGIN=<url фронтенда>
#   auditor-web (frontend, Root=web):
#     VITE_API_BASE_URL=https://<auditor-api>.vercel.app   (публичная; НЕ класть сюда секреты)
# ==========================================
