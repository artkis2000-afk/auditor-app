# ==========================================
# ФУРЫ ЗАПЧАСТИ — переменные окружения
# Скопируйте в .env и заполните реальными значениями. .env НЕ коммитится.
# ==========================================

# --- Server ---
PORT=3000
NODE_ENV=development

# --- Auth (PHASE 4.5) ---
# Секрет для подписи JWT. В production обязателен собственный сильный секрет.
JWT_SECRET=change-me-in-production

# --- Gemini AI / OCR (PHASE 4.6) ---
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# --- Firebase / Firestore (PHASE 4.3, Admin SDK, server-side) ---
# Существующий проект и БД — единственный источник истины. Локального fallback нет.
FIREBASE_PROJECT_ID=zakupki-auditor
FIRESTORE_DATABASE_ID=ai-studio-527e9c56-1154-4b10-ae2e-2b1cd4743c8f
# Аутентификация Admin SDK — ОДИН из вариантов:
#  1) JSON сервисного аккаунта строкой (Firebase Console → Project settings → Service accounts):
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"zakupki-auditor",...}
#  2) путь к файлу сервисного аккаунта (Application Default Credentials):
# GOOGLE_APPLICATION_CREDENTIALS=./secrets/service-account.json
