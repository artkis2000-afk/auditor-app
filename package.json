{
  "name": "fury-zapchasti",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "ФУРЫ ЗАПЧАСТИ — система аудита закупок автозапчастей (standalone: Firestore + Gemini). Reverse-engineered рефакторинг приложения из Google AI Studio.",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx server/index.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "build": "esbuild server/index.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "build:web": "vite build --config web/vite.config.ts",
    "start": "node dist/server.cjs",
    "smoke:ocr": "tsx scripts/smokeOcr.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p web/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@google/genai": "^2.23.0",
    "@vercel/oidc": "^3.8.8",
    "express": "^5.2.1",
    "firebase-admin": "^14.4.0",
    "google-auth-library": "^11.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/express": "^5.0.6",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.28.2",
    "jsdom": "^25.0.1",
    "supertest": "^7.2.2",
    "tsx": "^4.23.13",
    "typescript": "~5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
